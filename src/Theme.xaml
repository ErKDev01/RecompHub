<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Paleta padrão (o hub). Cada página de jogo sobrescreve estas chaves nos seus Resources. -->
  <SolidColorBrush x:Key="Bg" Color="#0C0C0D"/>
  <SolidColorBrush x:Key="Panel" Color="#141415"/>
  <SolidColorBrush x:Key="Card" Color="#1B1B1D"/>
  <SolidColorBrush x:Key="Line" Color="#2A2A2D"/>
  <SolidColorBrush x:Key="Text" Color="#ECE9E4"/>
  <SolidColorBrush x:Key="Muted" Color="#A29E98"/>
  <SolidColorBrush x:Key="Dim" Color="#8C8882"/>
  <SolidColorBrush x:Key="Accent" Color="#D9D4CC"/>
  <SolidColorBrush x:Key="AccentHi" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccentLo" Color="#3A3936"/>
  <SolidColorBrush x:Key="OnAccent" Color="#0C0C0D"/>
  <SolidColorBrush x:Key="Focus" Color="#9B7BFF"/>
  <SolidColorBrush x:Key="Ok" Color="#7CC47F"/>
  <SolidColorBrush x:Key="Warn" Color="#E3AE52"/>
  <!-- Cor da marca (a seta âmbar da logo): marcador do item ativo da barra lateral -->
  <SolidColorBrush x:Key="Brand" Color="#E9A23B"/>
  <!-- Realces translúcidos (botões, trilhos, rolagem): branco nos temas escuros; a paleta clara do hub troca pela cor do texto -->
  <SolidColorBrush x:Key="Wash" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="WashHi" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="WashLo" Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="WashLine" Color="#2AFFFFFF"/>
  <SolidColorBrush x:Key="Track" Color="#33FFFFFF"/>
  <SolidColorBrush x:Key="Thumb" Color="#40FFFFFF"/>
  <SolidColorBrush x:Key="ThumbHi" Color="#80FFFFFF"/>
  <!-- Item ativo da barra de ícones -->
  <SolidColorBrush x:Key="NavOn" Color="#24FFFFFF"/>
  <SolidColorBrush x:Key="NavOnText" Color="#FFFFFF"/>
  <!-- Botões da janela (minimizar, maximizar): claros sobre o escuro; o hub troca na paleta clara -->
  <SolidColorBrush x:Key="ChromeInk" Color="#C8C4BE"/>
  <CornerRadius x:Key="Radius">4</CornerRadius>

  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <!-- Anel duplo bem visível para o controle: halo na cor do tema + contorno branco -->
          <Grid IsHitTestVisible="False">
            <Rectangle Margin="-8" StrokeThickness="4" Stroke="{DynamicResource Focus}" Opacity="0.45" RadiusX="10" RadiusY="10"/>
            <Rectangle Margin="-4" StrokeThickness="2.5" Stroke="White" RadiusX="7" RadiusY="7"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="#1E1E20"/>
    <Setter Property="Foreground" Value="#ECE9E4"/>
    <Setter Property="BorderBrush" Value="#333336"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <!-- Botão principal (Jogar / Instalar) -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHi}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource Radius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentHi}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Opacity" Value="0.85"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="b" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Botão secundário -->
  <Style x:Key="GhostButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Background" Value="{DynamicResource Wash}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WashLine}"/>
    <Setter Property="Padding" Value="16,9"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource WashHi}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource WashLo}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Botão sem moldura (links, cartões clicáveis) -->
  <Style x:Key="BareButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource AccentHi}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Botões da barra de título -->
  <Style x:Key="ChromeButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource ChromeInk}"/>
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="Transparent" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource WashHi}"/>
              <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="Transparent" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#C42B1C"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Navegação da barra lateral do hub (pílula) -->
  <Style x:Key="SideNav" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="14,11">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="mark" Width="3" CornerRadius="2" Margin="0,10" HorizontalAlignment="Left" Background="{DynamicResource Brand}" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource Wash}"/>
              <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource WashHi}"/>
              <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Barra de ícones do hub: ícone com o nome embaixo; o ativo ganha fundo e o traço da marca à esquerda -->
  <Style x:Key="RailNav" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Width="60">
            <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="0,9,0,7">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <Border x:Name="mark" Width="3" CornerRadius="2" Margin="-8,12,0,12" HorizontalAlignment="Left" Background="{DynamicResource Brand}" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource Wash}"/>
              <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource NavOn}"/>
              <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{DynamicResource NavOnText}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Abas da página do jogo e das configurações -->
  <Style x:Key="TabItem" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="16,8,16,9">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource Wash}"/>
              <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource WashHi}"/>
              <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Opção segmentada -->
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,0,4,4"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="b" Background="{DynamicResource WashLo}" BorderBrush="{DynamicResource WashHi}" BorderThickness="1" CornerRadius="{DynamicResource Radius}" Padding="12,6" MinWidth="44">
            <ContentPresenter HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource WashHi}"/>
              <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentLo}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Interruptor -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="46" Height="24" Background="Transparent">
            <Border x:Name="track" CornerRadius="12" Background="#2C2C2E" BorderBrush="#3C3C3F" BorderThickness="1"/>
            <Ellipse x:Name="knob" Width="16" Height="16" Fill="#A29E98" HorizontalAlignment="Left" Margin="4,0,0,0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
              <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource AccentHi}"/>
              <Setter TargetName="knob" Property="Fill" Value="{DynamicResource OnAccent}"/>
              <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="knob" Property="Margin" Value="0,0,4,0"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Slider -->
  <Style x:Key="SliderThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Ellipse x:Name="e" Width="16" Height="16" Fill="{DynamicResource Text}" Stroke="{DynamicResource Accent}" StrokeThickness="3"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="e" Property="Stroke" Value="{DynamicResource AccentHi}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderRepeat" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderFill" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="RangeSlider" TargetType="Slider">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="22">
            <Border Height="4" CornerRadius="2" Background="{DynamicResource Track}" VerticalAlignment="Center"/>
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderRepeat}" Command="Slider.IncreaseLarge"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource SliderThumb}"/>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Campo de texto -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="#66000000"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius}">
            <!-- Sem Margin: a TextBox já repassa o Padding para o PART_ContentHost (com Margin o espaço dobrava e cortava o texto) -->
            <ScrollViewer x:Name="PART_ContentHost"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Barra de rolagem fina: o desenho fica longe da borda direita, onde os 6 px de redimensionar da janela roubam o mouse;
       a área clicável (transparente) é mais larga que o desenho -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="14"/>
    <Setter Property="MinWidth" Value="14"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                      <Border x:Name="t" CornerRadius="3" Background="{DynamicResource Thumb}" Margin="2,0,6,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="t" Property="Background" Value="{DynamicResource ThumbHi}"/>
                      </Trigger>
                      <Trigger Property="IsDragging" Value="True">
                        <Setter TargetName="t" Property="Background" Value="{DynamicResource ThumbHi}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Menu do botão Jogar -->
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="#1C1C1E"/>
    <Setter Property="BorderBrush" Value="#333336"/>
    <Setter Property="Foreground" Value="#ECE9E4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
            <Border.Effect>
              <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Color="Black"/>
            </Border.Effect>
            <StackPanel IsItemsHost="True"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="#ECE9E4"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="b" Background="Transparent" CornerRadius="3" Padding="14,9" MinWidth="230">
            <ContentPresenter ContentSource="Header"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="b" Property="Background" Value="#2E2E31"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="MenuSep" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Rectangle Height="1" Fill="#333336" Margin="10,4"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Barra de progresso -->
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource Track}"/>
            <Border x:Name="PART_Indicator" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
